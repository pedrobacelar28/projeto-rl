  "tdjepa_encoder_hidden_dim": 256,
  "tdjepa_encoder_hidden_layers": 2,
  "tdjepa_predictor_hidden_dim": 1024,
  "tdjepa_discount": 0.98,
  "tdjepa_orthonormality_coef": 1.0,
  "tdjepa_goal_share": 0.5,
