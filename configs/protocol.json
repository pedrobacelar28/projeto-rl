  "spr_dropout": 0.5,
  "spr_train_steps": 10000,
  "spr_batch_size": 256,
  "spr_learning_rate": 0.0003,
  "spr_target_tau": 0.99,
  "tjepa_hidden_dim": 64,
  "tjepa_num_layers": 4,
  "tjepa_num_heads": 8,
  "tjepa_feedforward_dim": 256,
  "tjepa_predictor_dim": 64,
  "tjepa_predictor_layers": 2,
  "tjepa_predictor_heads": 4,
  "tjepa_min_context_share": 0.2,
  "tjepa_max_context_share": 0.4,
  "tjepa_min_target_share": 0.2,
  "tjepa_max_target_share": 0.4,
  "tjepa_target_masks": 4,
  "tjepa_train_steps": 10000,
  "tjepa_batch_size": 512,
